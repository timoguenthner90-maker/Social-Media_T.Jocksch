---
import { site, nav, cta } from "../data/site";

// Aktuelle Seite für aria-current. Astro.url.pathname endet immer auf "/",
// weil der Build Verzeichnis-URLs erzeugt.
const here = Astro.url.pathname;
---

<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{site.name}</span>
      <span class="brand__role">Social &amp; Creator Marketing</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={here === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn nav__cta" href={cta.href}>{cta.label}</a>
    </nav>
  </div>
</header>
