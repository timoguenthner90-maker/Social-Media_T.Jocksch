---
import { site } from "../data/site";
import { pakete } from "../data/services";

const year = new Date().getFullYear();
const aufStartseite = Astro.url.pathname === "/";
const href = (anker: string) => (aufStartseite ? anker : `/${anker}`);
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <p style="font-family:var(--display);font-size:var(--step-2)">{site.name}</p>
        <p class="muted" style="margin-top:0.5rem">
          Social Media Management &amp; Content Creation<br />
          {site.zip}
          {site.city}
        </p>
      </div>

      <div>
        <p class="footer__head">Pakete</p>
        <ul class="footer__list">
          {
            pakete.map((p) => (
              <li>
                <a href={href("#leistungen")}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="footer__head">Kontakt</p>
        <ul class="footer__list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:+${site.phoneDigits}`}>{site.phoneDisplay}</a></li>
          <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
          <li>
            <a href={site.instagram} rel="me noopener">
              Instagram {site.instagramHandle}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {site.name}</span>
      <span>
        <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>
