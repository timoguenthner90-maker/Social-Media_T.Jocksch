---
import Base from "../layouts/Base.astro";
import { site, isTodo, phoneDisplay } from "../data/site";
import { ablauf } from "../data/services";
import { breadcrumbLd } from "../data/jsonld";

// Netlify Forms: Das Formular wird beim Deploy aus dem statischen HTML gelesen.
// Nötig sind `data-netlify`, ein verstecktes `form-name`-Feld (sonst kommt der
// POST ohne Zuordnung an) und der Honeypot. Kein JavaScript beteiligt.
//
// Auf Branche und Zeitraum als eigene Felder wird bewusst verzichtet — beides
// steht ohnehin in der Nachricht. Was bleibt, sind die zwei Angaben, die eine
// Anfrage wirklich vorqualifizieren: Leistung und Budgetrahmen.
//
// Kontaktwege, die noch Platzhalter sind, werden als Text statt als Link
// ausgegeben — eine tel:- oder wa.me-Adresse mit erfundener Nummer würde sonst
// bei einem fremden Anschluss landen.
const mailReady = !isTodo(site.email);
const phoneReady = !isTodo(site.phoneDigits);
const linkedinReady = !isTodo(site.linkedin);
---

<Base
  title="Kontakt — Tina Jocksch"
  description="Kennenlern-Call vereinbaren: 30 Minuten, unverbindlich. Per Formular, E-Mail, WhatsApp oder LinkedIn — Antwort in der Regel innerhalb eines Werktags."
  jsonLd={breadcrumbLd("Kontakt", "/kontakt/")}
>
  <section class="section section--tight">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h1>Reden wir über Ihre Marke.</h1>
      </div>
      <p class="lead">
        30 Minuten, unverbindlich, ohne Verkaufsgespräch. Erzählen Sie mir kurz, wo
        Sie stehen — ich melde mich in der Regel innerhalb eines Werktags zurück.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap split split--even">
      <!-- ---------- Formular ---------- -->
      <form
        class="form"
        name="kontakt"
        method="POST"
        action="/danke/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="kontakt" />
        <p class="hp">
          <label>Bitte nicht ausfüllen: <input name="bot-field" tabindex="-1" /></label>
        </p>

        <div class="form__row form__row--2">
          <div class="field">
            <label for="name">Name *</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="unternehmen">Unternehmen</label>
            <input
              id="unternehmen"
              name="unternehmen"
              type="text"
              autocomplete="organization"
            />
          </div>
        </div>

        <div class="field">
          <label for="email">E-Mail *</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        <div class="form__row form__row--2">
          <div class="field">
            <label for="leistung">Worum geht es?</label>
            <select id="leistung" name="leistung">
              <option value="">Bitte wählen</option>
              <option>Social Media Management</option>
              <option>Content Creation &amp; UGC</option>
              <option>Influencer &amp; Creator Marketing</option>
              <option>Strategie &amp; Projekt-Support</option>
              <option>Weiß ich noch nicht</option>
            </select>
          </div>
          <div class="field">
            <label for="budget">Budgetrahmen</label>
            <select id="budget" name="budget">
              <option value="">Bitte wählen</option>
              <option>Einmaliges Projekt bis 2.000 €</option>
              <option>Einmaliges Projekt ab 2.000 €</option>
              <option>Laufend 1.500–2.500 € / Monat</option>
              <option>Laufend ab 2.500 € / Monat</option>
              <option>Noch offen</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="nachricht">Ihre Nachricht *</label>
          <textarea
            id="nachricht"
            name="nachricht"
            required
            placeholder="Wo stehen Sie heute, und was soll sich ändern?"></textarea>
        </div>

        <label class="consent">
          <input type="checkbox" name="einwilligung" required />
          <span>
            Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung meiner
            Anfrage gespeichert und verarbeitet werden. Details in der
            <a href="/datenschutz/">Datenschutzerklärung</a>. *
          </span>
        </label>

        <div>
          <button class="btn" type="submit">Anfrage senden</button>
        </div>

        <p class="small muted">* Pflichtfeld</p>
      </form>

      <!-- ---------- Direkte Wege ---------- -->
      <div>
        <ul class="kanaele">
          <li>
            <span class="kanaele__label">E-Mail</span>
            <span class="kanaele__value">
              {
                mailReady ? (
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                ) : (
                  <span class="todo">{site.email}</span>
                )
              }
            </span>
          </li>
          <li>
            <span class="kanaele__label">WhatsApp</span>
            <span class="kanaele__value">
              {
                phoneReady ? (
                  <a href={`https://wa.me/${site.phoneDigits}`} rel="noopener">
                    {phoneDisplay()}
                  </a>
                ) : (
                  <span class="todo">{site.phoneDigits}</span>
                )
              }
            </span>
          </li>
          <li>
            <span class="kanaele__label">LinkedIn</span>
            <span class="kanaele__value">
              {
                linkedinReady ? (
                  <a href={site.linkedin} rel="me noopener">
                    Profil ansehen
                  </a>
                ) : (
                  <span class="todo">{site.linkedin}</span>
                )
              }
            </span>
          </li>
          <li>
            <span class="kanaele__label">Instagram</span>
            <span class="kanaele__value">
              <a href={site.instagram} rel="me noopener">{site.instagramHandle}</a>
            </span>
          </li>
        </ul>

        <p class="eyebrow" style="margin-top:2.5rem">So läuft es weiter</p>
        <ol class="steps">
          {
            ablauf.map((s) => (
              <li>
                <span class="steps__name">{s.step}</span>
                <span class="steps__text">{s.text}</span>
              </li>
            ))
          }
        </ol>

        <p class="small muted" style="margin-top:1.25rem">
          Sitz in {site.city}. Produktionen vor Ort im Rheinland, auf Absprache auch
          darüber hinaus. Betreuung und Strategie laufen remote.
        </p>
      </div>
    </div>
  </section>
</Base>
