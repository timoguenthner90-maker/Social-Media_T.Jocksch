---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Cta from "../components/Cta.astro";
import { pempelhome, reels, arbeiten } from "../data/cases";
import { site } from "../data/site";
import { breadcrumbLd } from "../data/jsonld";

// Die Reels laden erst beim Klick (preload="none"); sichtbar ist bis dahin nur
// das Poster. Vier Videos à ~2 MB würden die Seite sonst unnötig aufblähen —
// und ohne Autoplay braucht es auch kein JavaScript.
---

<Base
  title="Arbeiten — Tina Jocksch"
  description="Interior- und Lifestyle-Content: Reels, Fotoproduktionen und der Aufbau des Interior-Accounts @pempelhome — konzipiert, produziert und veröffentlicht."
  jsonLd={breadcrumbLd("Arbeiten", "/portfolio/")}
>
  <section class="section section--tight">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Arbeiten</p>
        <h1>Content, der die Atmosphäre mitnimmt</h1>
      </div>
      <p class="lead">
        Der Schwerpunkt liegt dort, wo ich am stärksten bin: Interior, Wohnen und
        Lifestyle — Räume, die über Material, Licht und Atmosphäre funktionieren und
        sich nicht erklären lassen, sondern gezeigt werden müssen.
      </p>
    </div>
  </section>

  <!-- ---------- Case: @pempelhome ---------- -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Case</p>
          <h2>{pempelhome.handle} — {pempelhome.title}</h2>
        </div>
        <p class="lead">{pempelhome.lead}</p>
      </div>

      <div class="grid grid--4">
        {
          pempelhome.images.map((img, i) => (
            <figure class="media media--45" data-reveal>
              <Picture
                name={img.file}
                alt={img.alt}
                sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
                loading={i === 0 ? "eager" : "lazy"}
              />
            </figure>
          ))
        }
      </div>

      <div class="split" style="margin-top:clamp(2.5rem,5vw,4rem)">
        <div>
          <h3 style="font-size:var(--step-2)">Wie ich vorgegangen bin</h3>
        </div>
        <ol class="steps">
          {
            pempelhome.blocks.map((b) => (
              <li>
                <span class="steps__name">{b.label}</span>
                <span class="steps__text">{b.text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <p style="margin-top:2rem">
        <a class="arrow" href={site.instagram} rel="noopener">
          {pempelhome.handle} auf Instagram ansehen
        </a>
      </p>
    </div>
  </section>

  <!-- ---------- Reels ---------- -->
  <section class="section section--sand">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Bewegtbild</p>
          <h2>Shortform, das trägt</h2>
        </div>
        <p class="lead">
          Vier Formate, die bei Interior-Marken zuverlässig funktionieren. Konzept,
          Dreh und Schnitt jeweils aus einer Hand. Zum Abspielen antippen — die
          Videos laden erst dann.
        </p>
      </div>

      <div class="grid grid--4">
        {
          reels.map((r) => (
            <figure data-reveal>
              <div class="media media--916">
                <video
                  controls
                  preload="none"
                  playsinline
                  poster={`/img/${r.file}-poster.webp`}
                  width="720"
                  height="1280"
                  aria-label={r.alt}
                >
                  <source src={`/video/${r.file}.mp4`} type="video/mp4" />
                  Ihr Browser kann dieses Video nicht abspielen.
                </video>
              </div>
              <figcaption>
                <strong style="color:var(--ink)">{r.title}</strong> — {r.text}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Weitere Arbeiten ---------- -->
  <section class="section">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Weitere Arbeiten</p>
          <h2>Produktionen für Interior- und Möbelmarken</h2>
        </div>
        <p class="lead">
          Studio und vor Ort: Set-Aufbau, Lichtsetzung, Foto und Bewegtbild — vom
          Materialdetail bis zum ganzen Raum.
        </p>
      </div>

      <div class="grid grid--4">
        {
          arbeiten.map((img) => (
            <figure class="media media--45" data-reveal>
              <Picture
                name={img.file}
                alt={img.alt}
                sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    title="Sie haben etwas Vergleichbares vor?"
    text="Erzählen Sie mir kurz, worum es geht — Marke, Ort, Zeitraum. Im Erstgespräch klären wir, welches Format dazu passt und was es kostet."
  />
</Base>
