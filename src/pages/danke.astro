---
import Base from "../layouts/Base.astro";
import { cta } from "../data/site";

// Zielseite nach dem Formularversand. noindex, weil sie ohne Absenden keinen
// Sinn ergibt und in Suchergebnissen nur verwirren würde.
---

<Base
  title="Danke für deine Nachricht — Tina Jocksch"
  description="Deine Anfrage ist angekommen. Ich melde mich in der Regel innerhalb eines Werktags zurück."
  noindex={true}
>
  <section class="section">
    <div class="wrap narrow">
      <h1 class="title">Danke für deine Nachricht.</h1>
      <p class="lead">
        Deine Anfrage ist angekommen. Ich melde mich in der Regel innerhalb eines
        Werktags zurück, mit einer ersten Einschätzung und einem Terminvorschlag.
      </p>
      <p class="small muted" style="margin-top:1rem">{cta.note}</p>
      <p style="margin-top:2.25rem">
        <a class="btn btn--blue" href="/">Zurück zur Startseite</a>
      </p>
    </div>
  </section>
</Base>
