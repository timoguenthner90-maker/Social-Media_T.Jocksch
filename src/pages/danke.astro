---
import Base from "../layouts/Base.astro";

// Zielseite nach dem Formularversand. noindex, weil sie ohne Absenden keinen
// Sinn ergibt und in Suchergebnissen nur verwirren würde.
---

<Base
  title="Danke für Ihre Nachricht — Tina Jocksch"
  description="Ihre Anfrage ist angekommen. Ich melde mich in der Regel innerhalb eines Werktags zurück."
  noindex={true}
>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Angekommen</p>
      <h1>Danke für Ihre Nachricht.</h1>
      <p class="lead" style="margin-top:1.5rem">
        Ich habe Ihre Anfrage erhalten und melde mich in der Regel innerhalb eines
        Werktags zurück — mit einer ersten Einschätzung und einem Terminvorschlag für
        das Kennenlern-Gespräch.
      </p>
      <p style="margin-top:2rem">
        <a class="btn btn--ghost" href="/">Zurück zur Startseite</a>
      </p>
      <p style="margin-top:2.5rem">
        <a class="arrow" href="/portfolio/">
          In der Zwischenzeit: meine Arbeiten ansehen
        </a>
      </p>
    </div>
  </section>
</Base>
