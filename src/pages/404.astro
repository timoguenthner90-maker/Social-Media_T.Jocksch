---
import Base from "../layouts/Base.astro";
import { nav } from "../data/site";
---

<Base
  title="Seite nicht gefunden — Tina Jocksch"
  description="Diese Seite gibt es nicht (mehr). Hier geht es zurück zur Startseite und zu den wichtigsten Abschnitten."
  noindex={true}
>
  <section class="section">
    <div class="wrap narrow">
      <h1 class="title">Diese Seite gibt es nicht.</h1>
      <p class="lead">
        Vielleicht hat sich die Adresse geändert, vielleicht ein Tippfehler. Hier
        kommst du weiter:
      </p>

      <ul class="chips" style="margin-top:1.75rem">
        <li><a href="/" style="text-decoration:none">Startseite</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={`/${item.href}`} style="text-decoration:none">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
