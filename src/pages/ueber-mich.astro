---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Cta from "../components/Cta.astro";
import { industries } from "../data/site";
import { personLd, breadcrumbLd } from "../data/jsonld";
---

<Base
  title="Über mich — Tina Jocksch"
  description="Seit über sechs Jahren an der Schnittstelle von Social Media, Content und Creator Marketing — mit Schwerpunkt auf Interior, Hospitality und Lifestyle."
  jsonLd={[personLd, breadcrumbLd("Über mich", "/ueber-mich/")]}
>
  <section class="section section--tight">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Über mich</p>
        <h1>Ich bin Tina.</h1>
        <p class="lead" style="margin-top:1.5rem">
          Seit über sechs Jahren arbeite ich an der Schnittstelle von Social Media,
          Content und Creator Marketing. Ich habe Redaktionspläne gebaut, Reels
          geschnitten, Creator gebrieft und Kampagnen ausgewertet — meistens alles
          davon im selben Projekt.
        </p>
      </div>
      <!-- Kein data-reveal: LCP-Bild, siehe index.astro. -->
      <figure class="media media--45">
        <Picture
          name="tina-portrait"
          alt="Porträt von Tina Jocksch"
          sizes="(min-width: 900px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- ---------- Warum dieser Fokus ---------- -->
  <section class="section section--sand">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Warum dieser Fokus</p>
        <p class="pull">
          Ein Raum wirkt — oder er wirkt nicht. Erklären lässt er sich nicht.
        </p>
      </div>
      <div class="stack">
        <p>
          Was mich an Interior, Hospitality und Lifestyle festhält: Das sind Marken,
          die man nicht beschreiben kann. Ein Hotelzimmer, ein Restaurant, ein Sofa —
          darüber entscheidet jemand heute lange vor dem ersten Besuch, auf einem
          Bildschirm, in drei Sekunden.
        </p>
        <p>
          Genau diese Übersetzung ist der Teil der Arbeit, den ich am liebsten mache:
          aus einem Ort ein Gefühl machen, das durch ein Handydisplay passt. Dafür
          braucht es beides — ein Auge für Licht, Material und Timing, und den
          nüchternen Blick darauf, ob es am Ende etwas gebracht hat.
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- Arbeitsweise ---------- -->
  <section class="section">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Arbeitsweise</p>
          <h2>Wie ich arbeite</h2>
        </div>
        <p class="lead">
          Drei Dinge, auf die Sie sich verlassen können — und die den Unterschied
          machen, wenn jemand von außen dazukommt.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card" data-reveal>
          <span class="card__num">01</span>
          <h3 class="card__title">Ich sage, was geht</h3>
          <p class="card__text">
            Und was nicht. Wenn ein Ziel mit dem vorhandenen Budget nicht erreichbar
            ist, hören Sie das von mir vor dem Angebot — nicht im dritten
            Monatsreport.
          </p>
        </div>
        <div class="card" data-reveal>
          <span class="card__num">02</span>
          <h3 class="card__title">Ich arbeite selbstständig</h3>
          <p class="card__text">
            Sie geben die Richtung vor, nicht die Aufgabenliste. Nachfassen,
            hinterhertelefonieren und Wiedervorlagen sind nicht Ihr Job.
          </p>
        </div>
        <div class="card" data-reveal>
          <span class="card__num">03</span>
          <h3 class="card__title">Ich lege Zahlen offen</h3>
          <p class="card__text">
            Jeden Monat, mit Einordnung — auch wenn ein Monat schlechter lief als der
            davor. Alles andere macht Optimierung unmöglich.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Fotostrecke Produktion ---------- -->
  <section class="section section--tight">
    <div class="wrap grid grid--4">
      <figure class="media media--45" data-reveal>
        <Picture
          name="tina-work"
          alt="Dreh mit Gimbal während einer Content-Produktion"
          sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
        />
      </figure>
      <figure class="media media--45" data-reveal>
        <Picture
          name="bts-licht"
          alt="Lichtsetzung um ein Sofa während einer Studioproduktion"
          sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
        />
      </figure>
      <figure class="media media--45" data-reveal>
        <Picture
          name="bts-spiegel"
          alt="Studio mit Spiegelwand, Equipment und aufgebautem Set"
          sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
        />
      </figure>
      <figure class="media media--45" data-reveal>
        <Picture
          name="tina-sofa"
          alt="Tina Jocksch auf einem hellen Sofa"
          sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
        />
      </figure>
    </div>
  </section>

  <!-- ---------- Branchen ---------- -->
  <section class="section section--sand">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Branchen</p>
          <h2>Mit wem ich arbeite</h2>
        </div>
        <p class="lead">
          Der gemeinsame Nenner ist nicht die Branche, sondern die Abhängigkeit von
          Ästhetik und Erlebnis.
        </p>
      </div>
      <div class="grid grid--3">
        {
          industries.map((b) => (
            <div class="card" data-reveal>
              <h3 class="card__title">{b.name}</h3>
              <p class="card__text">{b.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    title="Lernen wir uns kennen."
    text="Ein Gespräch kostet nichts und klärt in 30 Minuten mehr als drei E-Mails. Erzählen Sie mir, wo Sie stehen — ich sage Ihnen ehrlich, ob und wie ich helfen kann."
  />
</Base>
