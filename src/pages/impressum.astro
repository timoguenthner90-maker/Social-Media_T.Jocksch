---
import Base from "../layouts/Base.astro";
import { site, isTodo } from "../data/site";

// Angaben gemäß § 5 DDG (früher § 5 TMG).
//
// Alle Angaben stammen aus dem Lebenslauf. Offen ist nur die Steuerangabe —
// sie ist als Platzhalter markiert, und scripts/verify.mjs bricht ab, solange
// sie im Build steht. Siehe SPEC.md, Abschnitt „Offene Angaben".
const felder = [
  { label: "Anbieterin", wert: site.legalName },
  { label: "Anschrift", wert: site.street },
  { label: "PLZ / Ort", wert: `${site.zip} ${site.city}` },
  { label: "E-Mail", wert: site.email },
  { label: "Telefon", wert: site.phoneDisplay },
  { label: "Umsatzsteuer", wert: site.vatId },
];
---

<Base
  title="Impressum — Tina Jocksch"
  description="Anbieterkennzeichnung nach § 5 DDG: Name, Anschrift, Kontakt und Umsatzsteuerangaben."
  noindex={true}
>
  <section class="section">
    <div class="wrap narrow">
      <h1 class="title">Impressum</h1>

      <h2 style="font-size:var(--step-2);margin:2rem 0 1rem">Angaben gemäß § 5 DDG</h2>
      <dl class="kanaele">
        {
          felder.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>
                {isTodo(f.wert) ? <span class="todo">{f.wert}</span> : f.wert}
              </dd>
            </div>
          ))
        }
      </dl>

      <h2 style="font-size:var(--step-2);margin:2.5rem 0 1rem">
        Verantwortlich für den Inhalt
      </h2>
      <p>
        Verantwortlich nach § 18 Abs. 2 MStV ist die oben genannte Anbieterin unter
        der genannten Anschrift.
      </p>

      <h2 style="font-size:var(--step-2);margin:2.5rem 0 1rem">Streitbeilegung</h2>
      <p>
        Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung
        bereit: <a href="https://ec.europa.eu/consumers/odr/" rel="noopener"
          >ec.europa.eu/consumers/odr</a
        >. Ich bin nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren
        vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>

      <h2 style="font-size:var(--step-2);margin:2.5rem 0 1rem">Bildnachweis</h2>
      <p>
        Sämtliche Fotos und Videos auf dieser Website stammen von {site.name} und sind
        urheberrechtlich geschützt. Eine Verwendung ohne schriftliche Zustimmung ist
        nicht gestattet.
      </p>

      <h2 style="font-size:var(--step-2);margin:2.5rem 0 1rem">Haftung</h2>
      <p>
        Die Inhalte dieser Seiten wurden mit Sorgfalt erstellt. Für die Richtigkeit,
        Vollständigkeit und Aktualität kann jedoch keine Gewähr übernommen werden. Für
        Inhalte externer Links sind ausschließlich deren Betreiber verantwortlich; zum
        Zeitpunkt der Verlinkung waren keine Rechtsverstöße erkennbar.
      </p>

      <p style="margin-top:2.5rem"><a class="btn btn--blue" href="/">Zur Startseite</a></p>
    </div>
  </section>
</Base>
