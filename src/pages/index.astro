---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Cta from "../components/Cta.astro";
import { cta, industries, site } from "../data/site";
import { pillars } from "../data/services";
import { pempelhome, arbeiten, reels } from "../data/cases";
import { personLd, businessLd, websiteLd } from "../data/jsonld";

// Die Reihenfolge folgt dem Golden Circle (docs/Website-Story.md):
// Why (Hero, Problem) → How (Arbeitsweise) → What (Leistungen, Arbeiten).
// Wer von oben nach unten liest, trifft die Leistungsliste erst, wenn die
// Haltung dahinter schon steht.
//
// Arbeiten und Über mich sind Abschnitte dieser Seite statt eigener Routen —
// die Navigation springt per Anker hierher.
---

<Base
  title="Tina Jocksch — Social Media & Creator Marketing"
  description="Social-Media-Strategie, Content Creation und Influencer Marketing aus einer Hand — für Interior-, Hospitality- und Lifestyle-Marken aus Düsseldorf."
  jsonLd={[personLd, businessLd, websiteLd]}
>
  <!-- ---------- Hero: Why ---------- -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Social Media · Content · Creator Marketing</p>
        <h1>Sichtbar ist nicht genug.<br />Marken und Orte sollen erlebbar sein.</h1>
        <p class="lead">
          Ich verbinde Social-Media-Strategie, eigene Content-Produktion und Creator
          Marketing zu einem Auftritt, der die Atmosphäre einer Marke auf den
          Bildschirm bringt — und ihre Wirkung in Zahlen sichtbar macht.
        </p>
        <div class="hero__actions">
          <a class="btn" href={cta.href}>{cta.label}</a>
          <a class="arrow" href="#arbeiten">Arbeiten ansehen</a>
        </div>
      </div>

      <!-- Kein data-reveal: Das Heldenbild ist der LCP. Es soll sofort stehen und
           nicht auf den IntersectionObserver warten. -->
      <figure class="media media--34">
        <Picture
          name="tina-hero"
          alt="Tina Jocksch sitzt auf einem modularen Sofa in einem hellen Studio"
          sizes="(min-width: 900px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- ---------- Problem und Ansatz ---------- -->
  <section class="section section--sand">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Das Problem</p>
        <p class="pull">„Uns fehlt einfach die Zeit.“</p>
      </div>
      <div class="stack">
        <p>
          Es fehlt nicht an Ideen, sondern an Kapazität: ein Team, das Social Media
          nebenbei mitmacht, ein Feed, der unregelmäßig läuft — und eine Konkurrenz,
          die online sichtbarer ist.
        </p>
        <p>
          Was Sie suchen, ist keine weitere Agentur mit Zwischenebenen, sondern
          jemanden, der die operative Arbeit übernimmt, <strong>ohne dass Sie die
          Kontrolle über Marke und Tonalität abgeben.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- Arbeitsweise: How ---------- -->
  <section class="section">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="eyebrow">Der Ansatz</p>
          <h2>Alles aus einer Hand — und nachprüfbar</h2>
        </div>
        <p class="lead">
          Die meisten Marken arbeiten mit einer Agentur für die Strategie, einer
          Fotografin für die Bilder und einer weiteren Adresse für
          Influencer-Kampagnen. Dazwischen gehen Zeit, Budget und Tonalität verloren.
        </p>
      </div>

      <p class="lead" style="margin-bottom:clamp(2rem,4vw,3rem)">
        Bei mir läuft alles über einen Tisch: ein Briefing, eine Ansprechpartnerin,
        eine Handschrift — von der Strategie über die Produktion bis zur Kampagne.
      </p>

      <div class="grid grid--3">
        <div class="card" data-reveal>
          <span class="card__num">01</span>
          <h3 class="card__title">Strategisch denken</h3>
          <p class="card__text">
            Zielgruppe, Formate, Kanäle und Kennzahlen stehen fest, bevor der erste
            Beitrag entsteht. Nicht andersherum.
          </p>
        </div>
        <div class="card" data-reveal>
          <span class="card__num">02</span>
          <h3 class="card__title">Kreativ umsetzen</h3>
          <p class="card__text">
            Reels, Fotos und UGC produziere ich selbst — vor Ort, in Ihrer
            Bildsprache, mit Schnitt und finaler Fassung aus einer Hand.
          </p>
        </div>
        <div class="card" data-reveal>
          <span class="card__num">03</span>
          <h3 class="card__title">Messbar weiterentwickeln</h3>
          <p class="card__text">
            Monatliches Reporting mit klaren Zahlen und Einordnung — auch dann, wenn
            ein Monat schlechter lief als der davor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Leistungen: What ---------- -->
  <section class="section section--sand">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)">
        <div>
          <p class="eyebrow">Leistungen</p>
          <h2>Vier Säulen, ein Auftritt</h2>
        </div>
        <p class="lead">
          Einzeln buchbar — im Zusammenspiel am stärksten, weil Strategie, Content
          und Creator-Kampagnen dann derselben Linie folgen.
        </p>
      </div>

      <ol class="steps">
        {
          pillars.map((p) => (
            <li>
              <span class="steps__name">
                <a href={`/leistungen/#${p.slug}`} class="steps__link">
                  {p.name}
                </a>
              </span>
              <span class="steps__text">{p.claim}</span>
            </li>
          ))
        }
      </ol>

      <p style="margin-top:2rem">
        <a class="arrow" href="/leistungen/">Leistungen und Preise im Detail</a>
      </p>
    </div>
  </section>

  <!-- ---------- Arbeiten ---------- -->
  <section class="section" id="arbeiten">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)">
        <div>
          <p class="eyebrow">Arbeiten</p>
          <h2>Was dabei herauskommt</h2>
        </div>
        <p class="lead">
          Interior- und Lifestyle-Content: konzipiert, produziert, geschnitten und
          veröffentlicht. Räume, die über Material, Licht und Atmosphäre wirken.
        </p>
      </div>

      <div class="grid grid--4">
        {
          arbeiten.map((img) => (
            <figure class="media media--45" data-reveal>
              <Picture
                name={img.file}
                alt={img.alt}
                sizes="(min-width: 900px) 23vw, (min-width: 600px) 45vw, 100vw"
              />
            </figure>
          ))
        }
      </div>

      <div class="split" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
        <div class="stack">
          <p class="pull">{pempelhome.handle}</p>
          <p>{pempelhome.lead}</p>
          <p>
            <a class="arrow" href={site.instagram} rel="noopener">
              Auf Instagram ansehen
            </a>
          </p>
        </div>

        <div class="reels">
          {
            reels.map((r) => (
              <figure data-reveal>
                <div class="media media--916">
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster={`/img/${r.file}-poster.webp`}
                    width="720"
                    height="1280"
                    aria-label={r.alt}
                  >
                    <source src={`/video/${r.file}.mp4`} type="video/mp4" />
                    Ihr Browser kann dieses Video nicht abspielen.
                  </video>
                </div>
                <figcaption>
                  <strong style="color:var(--ink)">{r.title}</strong> — {r.text}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Über mich ---------- -->
  <section class="section section--sand" id="ueber-mich">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Über mich</p>
        <h2>Ich bin Tina.</h2>
        <div class="stack" style="margin-top:1.5rem">
          <p class="lead">
            Seit über sechs Jahren arbeite ich an der Schnittstelle von Social Media,
            Content und Creator Marketing — Redaktionspläne, Reels, Creator-Briefings
            und Kampagnenauswertung, meistens alles davon im selben Projekt.
          </p>
          <p>
            Was mich an Interior, Hospitality und Lifestyle festhält: Das sind Marken,
            die man nicht beschreiben kann. Ein Raum wirkt oder er wirkt nicht, und
            entschieden wird das heute lange vor dem ersten Besuch — auf einem
            Bildschirm, in drei Sekunden. Genau diese Übersetzung ist der Teil der
            Arbeit, den ich am liebsten mache.
          </p>
          <p>
            Ich sage, was geht und was nicht. Ich arbeite selbstständig, ohne dass Sie
            hinterherfragen müssen. Und ich lege Zahlen offen, auch wenn ein Monat
            schlechter lief als der davor.
          </p>
        </div>

        <p class="eyebrow" style="margin-top:2.5rem">Branchen</p>
        <ul class="taglist">
          {industries.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <figure class="media media--45" data-reveal>
        <Picture
          name="tina-portrait"
          alt="Porträt von Tina Jocksch"
          sizes="(min-width: 900px) 42vw, 100vw"
        />
      </figure>
    </div>
  </section>

  <Cta />
</Base>
