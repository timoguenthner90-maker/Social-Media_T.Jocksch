---
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import { site, cta, heroMedia, laufband } from "../data/site";
import { leistungen, pakete, preishinweis, tagessatz } from "../data/services";
import { kennzahlen, werkzeuge, stationen, ausbildung } from "../data/experience";
import { beispiele, accountHinweis, feedTransformationen } from "../data/work";
import {
  problemZitate,
  problemText,
  guideEmpathie,
  planSchritte,
  ergebnis,
} from "../data/story";
import { personLd, businessLd, websiteLd } from "../data/jsonld";

// One-Pager. Gestaltung und Wortlaut folgen Tinas eigenem Entwurf
// (~/Desktop/Eigene Website Tina/webseite vorlage): englische Abschnittstitel
// in Kleinschreibung mit Punkt, deutscher Text, Farbflächen im Wechsel.
//
// Der AUFBAU folgt jetzt dem Ecomex-Homepage-Wireframe (12-Zonen-Checkliste),
// mit den StoryBrand-Inhalten (Donald Miller) als Text in diesen Zonen:
//
//   Logo/Nav/CTA          → Header (eigene Komponente)
//   Hauptbild + Headline
//   + Einleitung + CTA    → Hero
//   Painpoints + CTA      → the problem  (Zitate aus der Empathy Map)
//   Vorstellung/Autorität
//   + CTA                 → about        (Bio + track record, ein Block)
//   Plan (3 Schritte)
//   + CTA                 → the plan
//   (Angebot konkret)     → services     (Leistungen und Preise)
//   (Beleg)                → creative work
//   Weitere Elemente
//   & Footer               → contact + Footer
//
// Zwei Wireframe-Zonen fehlen bewusst: Auszeichnungen/Siegel (keine
// vorhanden) und Testimonials (noch keine eigenen Kunden). Beides nachträglich
// einbauen, sobald es echte Inhalte dafür gibt — siehe GATE.md.
//
// Bewusst NICHT im StoryBrand-Ton: keine rhetorischen Fragen, keine
// Angstmache. Die Zielgruppe reagiert auf Sachlichkeit.
---

<Base
  title="Tina Jocksch — Social Media & Creator Marketing"
  description="Social-Media-Strategie, Redaktionsplanung, Community Management und Creator Partnerships — laufende Kanalbetreuung für Marken aus Düsseldorf."
  jsonLd={[personLd, businessLd, websiteLd]}
>
  <!-- ================= Hero ================= -->
  <section class="hero" id="start">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{site.role}</p>
        <h1>gib den Kanal ab.<br />nicht die Marke.</h1>
        <p class="lead">
          Strategie, Redaktionsplanung, Posting, Community — ich übernehme den
          Alltag deines Kanals. Du behältst Ton, Freigabe und Überblick. Sichtbar
          wird die Marke dann planbar statt zufällig.
        </p>
        <div class="hero__actions">
          <a class="btn btn--blue" href={cta.href}>{cta.label}</a>
          <a href="#plan" style="font-size:var(--step--1)">So läuft die Zusammenarbeit</a>
        </div>
      </div>

      <!-- Medien-Slot: nimmt Bild ODER Hintergrundvideo auf, gesteuert über
           heroMedia in src/data/site.ts. Kein data-reveal — das ist der LCP
           und soll sofort stehen. -->
      <figure class="media media--45">
        {
          heroMedia.art === "video" ? (
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={`/img/${heroMedia.name}-poster.webp`}
              aria-label={heroMedia.alt}
            >
              <source src={`/video/${heroMedia.name}.mp4`} type="video/mp4" />
            </video>
          ) : (
            <Picture
              name={heroMedia.name}
              alt={heroMedia.alt}
              sizes="(min-width: 900px) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </figure>
    </div>
  </section>

  <!-- ================= Laufband ================= -->
  <div class="laufband" aria-hidden="true">
    <div class="laufband__spur">
      <ul>{laufband.map((w) => <li>{w}</li>)}</ul>
      <ul>{laufband.map((w) => <li>{w}</li>)}</ul>
    </div>
  </div>

  <!-- ================= Painpoints (the problem) ================= -->
  <!-- Wireframe-Zone 6: Painpoints. StoryBrand-Schritt 1: Der Kunde ist der
       Held und hat ein Problem. Ohne diesen Abschnitt handelt die ganze
       Seite nur von Tina, und der Besucher erkennt sich nirgends wieder. Die
       Zitate stehen wörtlich so in der Empathy Map, die Grid-Kacheln
       entsprechen den "Painpoint #1–6"-Boxen des Wireframes. -->
  <section class="section" id="problem">
    <div class="wrap">
      <h2 class="title">the problem.</h2>
      <p class="lead" style="margin-bottom:2rem">{problemText.lead}</p>

      <ul class="zitate">
        {problemZitate.map((z) => <li data-reveal>„{z}“</li>)}
      </ul>

      <p style="margin-top:2.25rem;max-width:62ch">{problemText.schluss}</p>

      <div style="margin-top:2.5rem">
        <a class="btn btn--blue" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </section>

  <!-- ================= Vorstellung / Autorität (about) ================= -->
  <!-- Wireframe-Zone 7: "Vorstellung - (Autorität)". Text links (wer ich bin),
       Bild rechts, darunter die Belege für die Autorität — Kennzahlen,
       Werkzeuge und Stationen, vormals ein eigener "track record"-Abschnitt.
       Ein Block statt zwei, weil beides dieselbe Frage beantwortet: warum
       ausgerechnet Tina. -->
  <section class="section section--beige" id="ueber-mich">
    <div class="wrap split split--top">
      <div>
        <h2 class="title">hi, I'm Tina.</h2>
        <div class="stack">
          <p>{guideEmpathie}</p>
          <p>
            Angefangen habe ich im B2B, danach fünf Jahre bei einer
            Premium-Lifestyle-Marke mit einem Creator-Netzwerk von über 200
            Partnern. Am liebsten arbeite ich mit Marken, die man sehen muss, um
            sie zu verstehen — oft Interior, Hospitality und Lifestyle, aber
            längst nicht nur: Ich betreue auch einen Tennis-Account.
          </p>
          <p>
            Mein Anspruch: <strong>weniger Content um des Contents willen, mehr
            Ideen mit Strategie und Wirkung.</strong> Und wenn etwas nicht
            funktioniert, sage ich dir das — auch wenn es meine eigene Idee war.
          </p>
          <p style="font-family:var(--display);font-size:var(--step-2);margin-top:0.5rem">
            Think. Create. Connect.
          </p>
        </div>
      </div>

      <figure class="media media--45" data-reveal>
        <Picture
          name="tina-portrait"
          alt="Porträt von Tina Jocksch"
          sizes="(min-width: 900px) 45vw, 100vw"
        />
      </figure>
    </div>

    <div class="wrap" style="margin-top:clamp(3rem,6vw,4.5rem)">
      <p class="eyebrow" style="margin-bottom:1.25rem">track record</p>
      <p style="margin-bottom:2rem;max-width:56ch">
        Was ich in diesen sechs Jahren aufgebaut habe, setze ich jetzt für deine
        Marke ein.
      </p>

      <ul class="chips" style="margin-bottom:2.25rem">
        {werkzeuge.map((w) => <li>{w}</li>)}
      </ul>

      <ul class="stats">
        {
          kennzahlen.map((k) => (
            <li data-reveal>
              <span class="stats__num">{k.zahl}</span>
              <span class="stats__label">{k.label}</span>
            </li>
          ))
        }
      </ul>

      <figure class="media media--169" style="margin-top:2.5rem" data-reveal>
        <Picture
          name="vetsak-showroom"
          alt="Showroom mit modularen Sofas vor einer Fensterfront"
          sizes="(min-width: 1200px) 1140px, 100vw"
        />
      </figure>

      <div style="margin-top:2.5rem">
        {
          stationen.map((s) => (
            <article class="station">
              <div>
                <p class="station__zeit">{s.zeit}</p>
                <p class="station__name">{s.firma}</p>
                <p class="station__rolle">{s.rolle}</p>
              </div>
              <div>
                <p class="station__ergebnis">{s.ergebnis}</p>
                <ul class="station__punkte">
                  {s.punkte.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <ul class="chips chips--plain">
                  {s.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <p class="small muted" style="margin-top:1.75rem">
        {ausbildung.studium} · {ausbildung.weiterbildung}
      </p>

      <div style="margin-top:2.5rem">
        <a class="btn btn--blue" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </section>

  <!-- ================= the plan ================= -->
  <!-- StoryBrand-Schritt 3: Der Guide gibt einen Plan. Beantwortet die Frage,
       die vor einem Retainer den Abschluss blockiert — was passiert, wenn ich
       ja sage? Danach folgt direkt der Handlungsaufruf. -->
  <section class="section section--blue" id="plan">
    <div class="wrap">
      <h2 class="title">the plan.</h2>
      <p class="lead" style="color:inherit;margin-bottom:2.5rem">
        Drei Schritte. Nach dem ersten weißt du, woran du bist — auch wenn wir
        danach nicht weitermachen.
      </p>

      <div class="plan">
        {
          planSchritte.map((schritt) => (
            <div data-reveal>
              <span class="plan__nummer">{schritt.nummer}</span>
              <p class="plan__titel">{schritt.titel}</p>
              <p class="plan__text">{schritt.text}</p>
            </div>
          ))
        }
      </div>

      <div class="split split--top" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
        <div>
          <p class="eyebrow" style="color:inherit;opacity:0.7">{ergebnis.titel}</p>
          <ul class="wandel">
            {ergebnis.punkte.map((punkt) => <li>{punkt}</li>)}
          </ul>
        </div>
        <div>
          <a class="btn" href={cta.href}>{cta.label}</a>
          <p class="small" style="margin-top:1rem;opacity:0.8;max-width:44ch">
            {ergebnis.kleinerEinstieg}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= services: Angebot UND Preis ================= -->
  <section class="section" id="leistungen">
    <div class="wrap">
      <h2 class="title">what I do.</h2>
      <p class="lead" style="max-width:60ch">
        Der Kern ist die laufende Betreuung eines Kanals — und was sie kostet,
        steht weiter unten offen dabei. Creator Partnerships kommen als zweite
        Säule dazu, Content produziere ich, wenn keiner da ist.
      </p>

      <!-- Die drei Disziplinen. Die Reihenfolge ist die Gewichtung: Betreuung
           zuerst, Content zuletzt und ausdrücklich als Ergänzung. -->
      <ul class="leistungen" style="margin-top:2.5rem">
        {
          leistungen.map((l, i) => (
            <li id={l.slug}>
              <div>
                <span class="leistungen__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="leistungen__name">{l.name}</span>
              </div>
              <div>
                <p>{l.text}</p>
                <p class="leistungen__tags">{l.tags.join(" · ")}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p
        class="eyebrow"
        style="margin-top:clamp(2.5rem,5vw,3.5rem);margin-bottom:1.25rem"
      >
        Pakete &amp; Preise
      </p>

      <div class="pakete">
        {
          pakete.map((p) => (
            <div class="paket" data-reveal>
              <p class="paket__kopf">
                {p.nummer} &nbsp; {p.name}
              </p>
              <p class="paket__was">{p.was}</p>

              <p class="paket__preis">
                {p.preis}
                <span class="paket__einheit">{p.einheit}</span>
              </p>

              <ul class="paket__liste">
                {p.enthalten.map((e) => (
                  <li>
                    <span>{e}</span>
                  </li>
                ))}
                {p.nichtEnthalten?.map((e) => (
                  <li class="nicht">
                    <span>{e}</span>
                  </li>
                ))}
              </ul>

              {p.hinweis && <p class="paket__hinweis">{p.hinweis}</p>}

              <a class="btn" href="#kontakt">
                Paket anfragen
              </a>
            </div>
          ))
        }
      </div>

      <!-- Der Tagessatz ist der Anker, aus dem alle Pakete gerechnet sind —
           und zugleich das direkte Vergleichsmaß zum Wettbewerb. -->
      <div class="tagessatz">
        <div>
          <p class="paket__kopf" style="margin-bottom:0.5rem">Projekt &amp; Interim</p>
          <p class="small">{tagessatz.text}</p>
        </div>
        <p class="paket__preis" style="border:0;padding:0">
          {tagessatz.preis}
          <span class="paket__einheit">{tagessatz.einheit}</span>
        </p>
      </div>

      <p class="small muted" style="margin-top:1.5rem;max-width:62ch">
        {preishinweis}
      </p>

      <div style="margin-top:2.5rem">
        <a class="btn btn--blue" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </section>

  <!-- ================= creative work ================= -->
  <section class="section section--beige-soft" id="arbeiten">
    <div class="wrap">
      <h2 class="title">creative work.</h2>
      <p class="lead" style="margin-bottom:2.5rem">
        Content-Produktion ist nicht mein Hauptgeschäft — aber wenn Material fehlt,
        mache ich es selbst. Diese Formate entstehen auf meinem eigenen Account.
        Zum Abspielen antippen, die Videos laden erst dann.
      </p>

      <div class="beispiele">
        {
          beispiele.map((b) => (
            <figure data-reveal>
              <div class="beispiel__kopf">
                <span class="beispiel__num">
                  {b.nummer} — {b.kategorie}
                </span>
                <p class="beispiel__titel">{b.titel}</p>
              </div>

              {b.video ? (
                <div class="phone">
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster={`/img/${b.video}-poster.webp`}
                    width="720"
                    height="1280"
                    aria-label={b.alt}
                  >
                    <source src={`/video/${b.video}.mp4`} type="video/mp4" />
                    Dein Browser kann dieses Video nicht abspielen.
                  </video>
                </div>
              ) : b.bild ? (
                <div class="phone">
                  <Picture
                    name={b.bild}
                    alt={b.alt!}
                    sizes="(min-width: 900px) 22vw, (min-width: 600px) 45vw, 90vw"
                  />
                </div>
              ) : (
                <div class="phone phone--platzhalter">
                  <span>Folgt</span>
                </div>
              )}

              <figcaption>{b.text}</figcaption>

              {b.zahlen && (
                <p class="beispiel__zahlen">
                  {b.zahlen.map((z) => (
                    <span class="beispiel__zahl">
                      <strong>{z.wert}</strong>
                      {z.label}
                    </span>
                  ))}
                </p>
              )}
            </figure>
          ))
        }
      </div>

      <p class="small muted" style="margin-top:2rem;max-width:62ch">
        <a href={site.instagram} rel="noopener">{accountHinweis.handle}</a> —
        {accountHinweis.text}
      </p>

      <!-- Feed Transformations: noch offene Plätze, keine erfundenen
           Screenshots. Derselbe .phone-Rahmen wie oben, damit jedes
           Content-Beispiel auf der Seite gleich aussieht. -->
      <p class="eyebrow" style="margin-top:clamp(2.5rem,5vw,3.5rem)">Kommt bald</p>
      <h3 style="font-size:var(--step-2);margin-bottom:1rem">feed transformations.</h3>
      <p class="lead" style="margin-bottom:2rem">{feedTransformationen.intro}</p>

      <div class="feed__accounts">
        {
          feedTransformationen.slots.map((s) => (
            <div class="feed__account" data-reveal>
              <span class="beispiel__num">Account {s.nummer}</span>
              <div class="feed__paar">
                <div>
                  <p class="feed__tag">vorher</p>
                  <div class="phone phone--platzhalter">
                    <span>Folgt</span>
                  </div>
                </div>
                <div>
                  <p class="feed__tag">nachher</p>
                  <div class="phone phone--platzhalter">
                    <span>Folgt</span>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= contact ================= -->
  <section class="section section--beige-soft" id="kontakt">
    <div class="wrap">
      <h2 class="title">contact.</h2>

      <div class="split split--top">
        <!-- Netlify Forms: Das Formular wird beim Deploy aus dem statischen HTML
             gelesen. Nötig sind `data-netlify`, ein verstecktes `form-name`-Feld
             und der Honeypot. Kein JavaScript beteiligt. -->
        <form
          class="form"
          aria-label="Anfrage senden"
          name="kontakt"
          method="POST"
          action="/danke/"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="kontakt" />
          <p class="hp">
            <label>Bitte nicht ausfüllen: <input name="bot-field" tabindex="-1" /></label>
          </p>

          <div class="form__row form__row--2">
            <div class="field">
              <label for="name">Name *</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">E-Mail *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
              />
            </div>
          </div>

          <div class="field">
            <label for="paket">Worum geht es?</label>
            <select id="paket" name="paket">
              <option value="">Bitte wählen</option>
              {
                pakete.map((p) => (
                  <option>
                    {p.nummer} {p.name}
                  </option>
                ))
              }
              <option>Projekt &amp; Interim (Tagessatz)</option>
              <option>Weiß ich noch nicht</option>
            </select>
          </div>

          <div class="field">
            <label for="nachricht">Nachricht *</label>
            <textarea
              id="nachricht"
              name="nachricht"
              required
              placeholder="Erzähl mir kurz von deiner Marke und deinen Zielen"></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="einwilligung" required />
            <span>
              Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung meiner
              Anfrage gespeichert und verarbeitet werden. Details in der
              <a href="/datenschutz/">Datenschutzerklärung</a>. *
            </span>
          </label>

          <div>
            <button class="btn" type="submit">Anfrage senden</button>
          </div>

          <p class="small muted">* Pflichtfeld · {cta.note}</p>
        </form>

        <!-- Zwei Wege stehen vorn: das Formular links und WhatsApp. Beides
             landet direkt bei Tina. Telefonnummer, LinkedIn und Instagram
             bleiben erreichbar, treten aber bewusst zurück — sonst stehen fünf
             gleichwertige Kanäle nebeneinander und keiner wird genutzt. -->
        <div>
          <p class="eyebrow">Am schnellsten</p>
          <p class="lead" style="margin-bottom:1.75rem">
            Nimm das Formular oder schreib mir per WhatsApp. Beides landet direkt
            bei mir — Antwort in der Regel innerhalb eines Werktags.
          </p>

          <a
            class="btn btn--blue kontakt__whatsapp"
            href={`https://wa.me/${site.phoneDigits}`}
            rel="noopener"
          >
            Per WhatsApp schreiben
          </a>

          <p class="small" style="margin-top:1.25rem">
            Lieber klassisch per Mail?
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>

          <hr class="kontakt__linie" />

          <ul class="social">
            <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
            <li><a href={site.instagram} rel="me noopener">Instagram</a></li>
          </ul>

          <p class="small muted" style="margin-top:1.25rem">
            {site.phoneDisplay} · {site.zip} {site.city} — Produktionen vor Ort im
            Rheinland, Betreuung und Strategie remote.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
